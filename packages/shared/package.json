{
  "name": "@siseep/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@casl/ability": "^6.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@siseep/eslint-config": "workspace:*",
    "@siseep/tsconfig": "workspace:*",
    "@types/node": "^22.20.7",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
