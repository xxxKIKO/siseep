    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "@siseep/shared": "workspace:*",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.11",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.6.0",
