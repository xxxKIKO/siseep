    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.7",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.2.0",
    "source-map-support": "^0.5.21",
