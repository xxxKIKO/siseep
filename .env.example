# =============================================================================
# Sistema de Evaluación Escolar — variables de entorno
# Copia este archivo a .env (pnpm dev lo hace solo la primera vez).
# Nunca subas .env al repositorio. Para staging/producción ver docs/deploy.md.
# =============================================================================

# --- General -----------------------------------------------------------------
# development | test | staging | production
NODE_ENV=development
# Puertos locales. Si chocan con otro proyecto, cámbialos aquí (pnpm dev avisa si están
# ocupados). Si cambias WEB_PORT, ajusta también WEB_ORIGIN y WEB_URL.
# PORT = API; WEB_PORT = web (Vite pasa /api a la API por proxy).
PORT=3000
WEB_PORT=5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Base de datos -----------------------------------------------------------
# Local: el MongoDB que ya tienes corriendo en 27017. SISEEP usa su propia base
# ("siseep"), así que convive con las bases de otros proyectos en el mismo servidor.
# Si ese MongoDB es standalone funciona, pero sin transacciones (se necesitan desde la
# etapa 1). Con replica set: agrega ?replicaSet=rs0 a la URI.
# Staging/producción (Atlas, siempre replica set):
#   mongodb+srv://USUARIO:CONTRASEÑA@cluster.xxxxx.mongodb.net/siseep?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/siseep
# true = si no hay MongoDB en MONGODB_URI, pnpm dev levanta uno propio (replica set rs0):
# docker compose (puerto 27018, cambia la URI a mongodb://127.0.0.1:27018/siseep?replicaSet=rs0&directConnection=true)
# o, sin Docker, un mongod local con datos en .data/mongo.
DEV_START_MONGO=false

# --- Autenticación -----------------------------------------------------------
# Secreto para firmar el access token (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-bytes
# Vida del access token en segundos (15 minutos).
JWT_ACCESS_TTL=900
# Vida del refresh token (cookie httpOnly) en días. Se renueva en cada uso.
REFRESH_TOKEN_TTL_DAYS=30
# Cookie con atributo Secure. Chrome y Firefox la aceptan en http://localhost.
# Si usas Safari en local y no se mantiene la sesión, pon false (solo en local).
COOKIE_SECURE=true
# Intentos de login por minuto por IP + correo, y bloqueo después (ms).
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_MS=60000
THROTTLE_LOGIN_BLOCK_MS=900000
# Vigencia de las invitaciones de personal (días) y del enlace de restablecer (minutos).
INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# --- Web ---------------------------------------------------------------------
# Orígenes permitidos por CORS (separados por coma).
WEB_ORIGIN=http://localhost:5173
# URL pública de la web: se usa en los enlaces de los correos.
WEB_URL=http://localhost:5173
# Número de proxies delante de la API (0 en local; ver docs/deploy.md para staging).
TRUST_PROXY=0
# Documentación interactiva en /api/docs.
SWAGGER_ENABLED=true

# --- Correo ------------------------------------------------------------------
# console = el correo se imprime en el log de la API (local).
# resend  = se envía con Resend (staging/producción; requiere RESEND_API_KEY).
MAIL_DRIVER=console
MAIL_FROM="Evaluación Allende <no-responder@example.com>"
RESEND_API_KEY=

# --- Seed (pnpm seed) --------------------------------------------------------
# Cuentas iniciales. Las contraseñas solo se usan al crear la cuenta: volver a
# correr el seed no cambia la contraseña de una cuenta existente.
# Mínimo 10 caracteres.
SEED_ADMIN_EMAIL=admin@allende.local
SEED_ADMIN_PASSWORD=Admin-Allende-2026
SEED_DIRECTOR_EMAIL=directora@allende.local
SEED_DIRECTOR_PASSWORD=Directora-Allende-2026
SEED_DIRECTOR_FIRST_NAME=Directora
SEED_DIRECTOR_LAST_NAME=
SEED_TEACHER_EMAIL=viry@allende.local
SEED_TEACHER_PASSWORD=Maestra-Viry-2026
